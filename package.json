{
  "name": "private-teaching-manager",
  "version": "1.8.8",
  "private": true,
  "description": "Private Teaching Manager v1.8.2 \u2014 full-cycle early payment support",
  "scripts": {
    "web": "npx http-server www -p 4173",
    "cap:sync": "npx cap sync",
    "android": "npx cap open android",
    "android:build": "cd android && gradlew assembleDebug",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.benarda.privateteachingmanager",
    "productName": "Private Teaching Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "www/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
